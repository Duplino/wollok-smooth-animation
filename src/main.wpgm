import wollok.game.*

object config {
	const property msPorFrame = 70   // 10 pasos × 70 ms = 700 ms por movimiento
	const property pasos = 10        // h1 … h10
}

object derecha {
	method eje() = "h"
	method signo() = 1
	method siguiente(pos) = pos.right(1)
}

object izquierda {
	method eje() = "h"
	method signo() = -1
	method siguiente(pos) = pos.left(1)
}

// En standby hasta tener los frames v
object arriba {
	method eje() = "v"
	method signo() = 1
	method siguiente(pos) = pos.up(1)
}

object abajo {
	method eje() = "v"
	method signo() = -1
	method siguiente(pos) = pos.down(1)
}

object reloj {
	const animados = []

	method animar(obj) { animados.add(obj) }
	method terminar(obj) { animados.remove(obj) }
	method tick() { animados.copy().forEach({ o => o.avanzar() }) }
}

class Estela {
	var property position
	var property image
}

class Coso {
	var property position
	var direccion = derecha
	var paso = 0
	var estela = null

	method moviendose() = estela != null

	method frame(n) = direccion.eje() + (direccion.signo() * n).toString() + ".png"

	method image() =
		if (self.moviendose()) self.frame(paso - config.pasos()) else "h0.png"

	method dentroDelTablero(pos) =
		pos.x().between(0, game.width() - 1) and pos.y().between(0, game.height() - 1)

	method move(dir) {
		const destino = dir.siguiente(position)
		if (not self.moviendose() and self.dentroDelTablero(destino)) {
			direccion = dir
			paso = 0
			estela = new Estela(position = position, image = self.frame(0))
			game.addVisual(estela)
			position = destino
			reloj.animar(self)
		}
	}

	method avanzar() {
		paso += 1
		if (paso == config.pasos()) {
			game.removeVisual(estela)
			estela = null
			reloj.terminar(self)
		} else {
			estela.image(self.frame(paso))
		}
	}
}

program AnimationMove {
	game.title("Pepita")
	game.height(16)
	game.width(25)
	game.cellSize(50)
	game.boardGround("fondo.png")

	const coso = new Coso(position = game.at(5, 8))
	game.addVisual(coso)

	game.onTick(config.msPorFrame(), "animacion", { reloj.tick() })

	keyboard.right().onPressDo({ coso.move(derecha) })
	keyboard.left().onPressDo({ coso.move(izquierda) })

	game.start()
}